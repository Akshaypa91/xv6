diff --git a/kalloc.c b/kalloc.c
index 14cd4f4..52ae39e 100644
--- a/kalloc.c
+++ b/kalloc.c
@@ -9,18 +9,18 @@
 #include "mmu.h"
 #include "spinlock.h"
 
+// MAX_FRAMES = PHYSTOP / PGSIZE ==> 57344
+#define max_frames 57344
+
 void freerange(void *vstart, void *vend);
 extern char end[]; // first address after kernel loaded from ELF file
                    // defined by the kernel linker script in kernel.ld
 
-struct run {
-  struct run *next;
-};
-
 struct {
   struct spinlock lock;
   int use_lock;
-  struct run *freelist;
+  char *free_frames[max_frames];
+  int free_cnt;
 } kmem;
 
 // Initialization happens in two phases.
@@ -33,6 +33,7 @@ kinit1(void *vstart, void *vend)
 {
   initlock(&kmem.lock, "kmem");
   kmem.use_lock = 0;
+  kmem.free_cnt = 0;
   freerange(vstart, vend);
 }
 
@@ -59,7 +60,6 @@ freerange(void *vstart, void *vend)
 void
 kfree(char *v)
 {
-  struct run *r;
 
   if((uint)v % PGSIZE || v < end || V2P(v) >= PHYSTOP)
     panic("kfree");
@@ -69,9 +69,14 @@ kfree(char *v)
 
   if(kmem.use_lock)
     acquire(&kmem.lock);
-  r = (struct run*)v;
-  r->next = kmem.freelist;
-  kmem.freelist = r;
+
+  if(kmem.free_cnt >= max_frames) {
+    panic("kfree: too many free frames");
+  }
+
+  kmem.free_frames[kmem.free_cnt] = v;
+  kmem.free_cnt++;
+
   if(kmem.use_lock)
     release(&kmem.lock);
 }
@@ -82,15 +87,18 @@ kfree(char *v)
 char*
 kalloc(void)
 {
-  struct run *r;
+  char *r = 0;
 
   if(kmem.use_lock)
     acquire(&kmem.lock);
-  r = kmem.freelist;
-  if(r)
-    kmem.freelist = r->next;
+
+  if(kmem.free_cnt > 0) {
+    kmem.free_cnt--;
+    r = kmem.free_frames[kmem.free_cnt];
+  }
+
   if(kmem.use_lock)
     release(&kmem.lock);
-  return (char*)r;
+  return r;
 }
 
